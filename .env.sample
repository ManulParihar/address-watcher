# 8453 for Base Mainnet, 84532 for Base Sepolia
CHAIN_ID=84532
PORT=3000

# Same database as Kokio-BFF: this service reads its orders and accounts collections
MONGODB_URI=mongodb://localhost:27017/kokio

# Alchemy RPC key, used for receipts, blocks and the backfill call
ALCHEMY_API_KEY=

# From the Address Activity webhook's detail page (or the create-webhook response)
ALCHEMY_ACTIVITY_WEBHOOK_ID=
ALCHEMY_ACTIVITY_SIGNING_KEY=

# Signing key of the Custom webhook that watches PriceCapUSDCentsUpdated
ALCHEMY_EVENTS_SIGNING_KEY=

# Backfill never reads before this block. Defaults to the protocol deployment block on Base Sepolia.
# Required on Base Mainnet once the protocol is deployed there.
BACKFILL_FROM_BLOCK=

# Dashboard auth token, sent as X-Alchemy-Token to update-webhook-addresses
ALCHEMY_NOTIFY_AUTH_TOKEN=

# Shared secret Kokio-BFF sends as x-internal-token on every non-webhook route
INTERNAL_API_TOKEN=

# How often PENDING wallets are sent to Alchemy and backfilled
SYNC_INTERVAL_MS=60000
