{
  "name": "address-watcher",
  "version": "0.1.0",
  "description": "Stores Kokio wallet activity from Alchemy Address Activity webhooks and serves it as a paged history",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file=.env dist/server.js",
    "create-webhooks": "node --env-file=.env scripts/create-webhooks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.2.1",
    "kokio-sdk": "3.4.0",
    "mongoose": "8.24.1",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.2"
  }
}
